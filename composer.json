{
  "name": "teqnomaze/code-coverage",
  "description": "Check for the code coverage using the clover report of phpunit.",
  "type": "package",
  "keywords": [
    "coverage",
    "phpunit",
    "clover"
  ],
  "license": "MIT",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^11"
  },
  "bin": [
    "bin/code-coverage"
  ],
  "autoload": {
    "psr-4": {
      "Teqnomaze\\Coverage\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Teqnomaze\\Coverage\\Test\\": "tests"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "phpcs": "./vendor/bin/phpcs --standard=phpcs.xml",
    "phpcbf": "./vendor/bin/phpcbf --standard=phpcs.xml",
    "phpstan": "./vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
    "phpunit": "./vendor/bin/phpunit --configuration phpunit.xml",
    "coverage": "php ./bin/code-coverage ./build/clover.xml 95"
  }
}
