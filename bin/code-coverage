#!/usr/bin/env php
<?php

declare(strict_types=1);

use Teqnomaze\Coverage\Inspector;

require dirname(__DIR__) . '/src/Inspector.php';

$clover = $argv[1] ?? '';
$threshold = isset($argv[2]) ? (int) $argv[2] : 80;

if ($clover === '') {
    fwrite(STDERR, 'Usage: coverage <clover.xml> [threshold=80]' . PHP_EOL);
    exit(2);
}

try {
    $inspector = new Inspector($clover, $threshold);
    $inspector->check()->output();
} catch (InvalidArgumentException | RuntimeException $exception) {
    fwrite(STDERR, $exception->getMessage() . PHP_EOL);
    exit(2);
}

exit($inspector->getExitCode());
